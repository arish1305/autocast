# AutoCast AI (Free Edition) - Environment Variables

# Local Intelligence (Ollama)
# Ensure Ollama is running locally: https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_RETRY_ATTEMPTS=3

# Neural Voice Synthesis (Edge-TTS)
# Default voice: en-US-GuyNeural (Free)
TTS_VOICE=en-US-GuyNeural

# Optional Free Tier Asset Keys
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# YouTube Publishing (Free Quota)
# Get credentials from Google Cloud Console
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# Application Configuration
NICHE=technology
LANGUAGE=en
REGION=US
VIDEO_FORMAT=short
UPLOAD_SCHEDULE=daily
TREND_MAX_AGE_DAYS=14
